	partition dim_region = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_region.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"market_launch_date"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"region_id", type text}, {"region_name", type text}, {"state", type text}, {"hub_city", type text}, {"hotwire_present_public", Int64.Type}, {"market_launch_date", type date}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
