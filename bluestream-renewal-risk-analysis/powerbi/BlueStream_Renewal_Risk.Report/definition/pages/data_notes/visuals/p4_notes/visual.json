          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What's real vs. synthetic",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F2A37"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022 Synthetic: 500 invented communities across South FL, Treasure Coast, Central FL, SW FL, Gulf Coast and Houston (~150K units), 24 months of NPS, upgrades and revenue, and ~169K work orders.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022 Public: the competitor profile above, from Blue Stream's and Hotwire's own releases and region pages. Hotwire's community count is a third-party estimate.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022 'Competitor active' is a synthetic flag standing in for CRM notes that a competing proposal was reported to the account team.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Definitions",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F2A37"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022 Truck-roll rate: share of trouble calls that sent a technician. Repeat visit: a second truck roll within 30 days (the telecom version of a 30-day readmission).",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022 NPS is unit-weighted. Upgrade take rate = residents paying for a faster tier \u00f7 active units (the base tier is included in HOA dues).",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022 Renewal risk score and fiber-conversion impact were calculated in SQL (window functions, CTEs) on a SQLite star schema, then loaded here.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              }
            ]
          }
        }
