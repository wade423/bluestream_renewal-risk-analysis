{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "p3_line_ops",
  "position": {
    "x": 20,
    "y": 304,
    "z": 30,
    "width": 820,
    "height": 404,
    "tabOrder": 30
  },
  "visual": {
    "visualType": "lineChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_month"
                    }
                  },
                  "Property": "month"
                }
              },
              "queryRef": "dim_month.month",
              "nativeQueryRef": "month",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "% AI Triaged"
                }
              },
              "queryRef": "_Measures.% AI Triaged",
              "nativeQueryRef": "% AI Triaged"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Truck Roll Rate"
                }
              },
              "queryRef": "_Measures.Truck Roll Rate",
              "nativeQueryRef": "Truck Roll Rate"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Repeat Visit Rate"
                }
              },
              "queryRef": "_Measures.Repeat Visit Rate",
              "nativeQueryRef": "Repeat Visit Rate"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Share AI-triaged rises as truck-roll and repeat rates fall (go-live Jul 2025)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}