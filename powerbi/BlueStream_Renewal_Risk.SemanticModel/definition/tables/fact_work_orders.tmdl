	partition fact_work_orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_work_orders.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"created_date"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"work_order_id", type text}, {"community_id", type text}, {"created_date", type date}, {"work_order_type", type text}, {"ai_triaged", Int64.Type}, {"triage_minutes", type number}, {"truck_roll", Int64.Type}, {"resolved_remotely", Int64.Type}, {"repeat_within_30d", Int64.Type}}, "en-US"),
				    AddMonth = Table.AddColumn(Typed, "month", each Date.StartOfMonth([created_date]), type date)
				in
				    AddMonth

	annotation PBI_ResultType = Table
