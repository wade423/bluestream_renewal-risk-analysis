				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"fiber_conversion_date", "contract_start_date", "contract_end_date"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"community_id", type text}, {"community_name", type text}, {"region_id", type text}, {"community_type", type text}, {"total_units", Int64.Type}, {"build_type", type text}, {"fiber_conversion_date", type date}, {"contract_start_date", type date}, {"contract_end_date", type date}, {"contract_term_years", Int64.Type}, {"times_renewed", Int64.Type}, {"bulk_tier_mbps", Int64.Type}, {"bulk_rate_per_door", type number}, {"competitor_activity_flag", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
