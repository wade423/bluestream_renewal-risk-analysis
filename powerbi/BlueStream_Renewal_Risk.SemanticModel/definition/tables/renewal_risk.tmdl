	partition renewal_risk = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "renewal_risk.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"contract_end_date"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"risk_rank", Int64.Type}, {"community_id", type text}, {"community_name", type text}, {"region_name", type text}, {"community_type", type text}, {"total_units", Int64.Type}, {"build_type", type text}, {"contract_end_date", type date}, {"days_to_renewal", Int64.Type}, {"competitor_activity_flag", Int64.Type}, {"nps_last3", type number}, {"nps_change_6mo", type number}, {"trouble_per_100_units_90d", type number}, {"risk_score", type number}, {"risk_tier", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
